{
  "name": "ki-arena-functions",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "check": "node --check index.js && for f in src/*.js scripts/*.js test/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js",
    "seed:provider-types": "node scripts/seed-provider-types.js",
    "migrate:characters": "node scripts/migrate-character-model.js",
    "seed:roles": "node scripts/seed-roles.js",
    "sync:envs": "node scripts/sync-environments.js",
    "grant:role": "node scripts/grant-role.js",
    "test:emulator": "node test/local-api.emulator.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  }
}
